# Copy to .env and fill in. Never commit .env.

# --- Providers (set at least one) ---
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=

# Ollama runs locally — no key, just a base URL
OLLAMA_BASE_URL=http://localhost:11434

# --- Budgets ---
# Hard caps that fail loudly, not silently.
BUDGET_MAX_TOKENS_PER_REQUEST=8000
BUDGET_MAX_COST_USD_PER_REQUEST=0.25
BUDGET_MAX_COST_USD_PER_SESSION=5.00

# --- Observability ---
OTEL_SERVICE_NAME=llmops-harness
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
PROMETHEUS_PORT=9464

# --- Server ---
LOG_LEVEL=INFO
